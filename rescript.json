{
  "name": "hmviz",
  "jsx": { "version": 4 },
  "sources": {
    "dir" : "src",
    "subdirs" : true
  },
  "bsc-flags": [
    "-bs-super-errors",
    "-bs-no-version-header"
  ],
  "package-specs": [
    {
      "module": "esmodule",
      "in-source": true
    }
  ],
  "suffix": ".bs.js",
  "namespace": true,
  "bs-dependencies": [
    "@rescript/react",
    "rescript-webapi"
  ],
  "bs-dev-dependencies": [
    "bs-react-testing-library"
  ],
  "refmt": 3
}
